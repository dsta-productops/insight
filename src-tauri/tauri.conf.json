{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "INSIGHT",
  "version": "0.1.0",
  "identifier": "com.insight.desktop",
  "build": {
    "frontendDist": "http://localhost:3000",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/standalone": "standalone",
      "resources/assets": "assets",
      "resources/bin": "bin"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
