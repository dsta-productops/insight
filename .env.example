# Optional — enables vector embeddings (OpenAI text-embedding-3-small).
# Without it, retrieval falls back to lexical (BM25-style) scoring.
OPENAI_API_KEY=

# Suggestion (coach) provider: ollama (default — local, free, offline),
# llamacpp (bundled local llama.cpp server — the packaged desktop app's default),
# anthropic (frontier quality), or groq (hosted free tier).
# This one variable also selects the post-session speaker-labeling model.
# llamacpp talks to an OpenAI-compatible llama-server (override with LLAMACPP_URL,
# default http://localhost:8080); the packaged app starts it and sets these.
# Auto-detect: if unset, uses anthropic when ANTHROPIC_API_KEY is present, else ollama.
# ollama requires: `brew install ollama`, `ollama serve`, `ollama pull llama3.1:8b`
#   (override with OLLAMA_URL / OLLAMA_MODEL. llama3.2:3b is ~2x faster but
#   noticeably worse at technique detection — 8b is the recommended default)
SUGGEST_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b

# Frontier-model swap (used only when SUGGEST_PROVIDER=anthropic).
# Point INSIGHT at whatever frontier model an environment makes available —
# switching model is a config change, no code edit.
#   ANTHROPIC_API_KEY  — required for the anthropic provider.
#   ANTHROPIC_MODEL    — which model (defaults to claude-opus-4-8 if unset).
#   ANTHROPIC_BASE_URL — optional; point at an internal/enclave gateway that
#                        speaks the Anthropic API instead of the public endpoint
#                        (read natively by the SDK). Leave unset for the public API.
# NOTE: the anthropic provider sends transcript windows off-box — only use it in
# an environment cleared to send interview content to that endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_BASE_URL=

# Transcription provider: local (default, whisper.cpp — free/offline), groq, or openai.
# local requires: `brew install whisper-cpp` + a model in data/models/.
#   The best available model is picked automatically (preference order:
#   ggml-large-v3-turbo-q5_0.bin > ggml-large-v3-turbo.bin > ggml-small.en.bin
#   > ggml-base.en.bin — download from huggingface.co/ggerganov/whisper.cpp).
#   Override with WHISPER_CPP_BIN / WHISPER_CPP_MODEL.
# groq requires GROQ_API_KEY (free tier at console.groq.com)
# openai requires OPENAI_API_KEY (paid)
TRANSCRIBE_PROVIDER=local
GROQ_API_KEY=
